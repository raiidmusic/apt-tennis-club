{$HEYFORM_HOST} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    # Request logs are disabled: form URLs carry a scoped member context.
    reverse_proxy heyform:9157
}
